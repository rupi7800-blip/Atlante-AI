# Porta HTTP
PORT=3000
# In produzione: abilita cookie Secure e HSTS
NODE_ENV=production
# Chiave master per cifrare le chiavi API dei provider AI (stringa lunga e casuale). OBBLIGATORIA in produzione.
APP_SECRET=
# Cartella dati (database SQLite e backup)
DATA_DIR=./data
# Dietro un reverse proxy (es. 1)
TRUST_PROXY=
# URL pubblico (usato nei link delle email)
PUBLIC_URL=https://atlante.example.it

# --- Notifiche ---
# Email via SMTP (facoltativa), es. smtps://utente:password@smtp.example.it:465
SMTP_URL=
MAIL_FROM=Atlante AI <no-reply@example.it>
# Contatto per le chiavi VAPID delle notifiche push (generate automaticamente al primo avvio)
VAPID_SUBJECT=mailto:admin@example.it

# --- Fonti ---
# Facoltativo: aumenta il limite della ricerca GitHub (da 10 a 30 ricerche/min)
GITHUB_TOKEN=
# Necessaria per attivare la fonte YouTube (YouTube Data API v3)
YOUTUBE_API_KEY=

# Disattiva i processi pianificati (es. in un'istanza secondaria)
DISABLE_SCHEDULER=
